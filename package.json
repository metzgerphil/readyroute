{
  "name": "readyroute",
  "private": true,
  "scripts": {
    "knowledge:build": "node ./scripts/build-ready-route-knowledge.js",
    "knowledge:validate": "node ./scripts/validate-ready-route-knowledge.js",
    "knowledge:release": "npm run knowledge:build && npm run knowledge:validate",
    "knowledge:stability": "npm --prefix backend run knowledge:stability",
    "knowledge:gold-gate": "npm --prefix backend run knowledge:gold-gate",
    "knowledge:gate": "npm run knowledge:release && npm run knowledge:gold-gate && npm run knowledge:stability",
    "verify": "bash ./scripts/verify.sh",
    "build:unified-hosting": "npm --prefix manager-portal run build && node ./scripts/build-unified-firebase-hosting.mjs",
    "deploy:backend": "bash ./scripts/release-backend.sh",
    "deploy:landing": "bash ./scripts/release-landing.sh",
    "deploy:portal": "bash ./scripts/release-portal.sh",
    "deploy:rra-test": "bash ./scripts/release-rra-test.sh",
    "setup:fedex-scheduler": "bash ./scripts/setup-cloud-scheduler-fedex-sync.sh",
    "smoke": "bash ./scripts/release-smoke.sh",
    "release:backend": "bash ./scripts/release-backend.sh",
    "release:landing": "bash ./scripts/release-landing.sh",
    "release:portal": "bash ./scripts/release-portal.sh",
    "release:smoke": "bash ./scripts/release-smoke.sh",
    "release:app:prep": "npm run knowledge:gate && cd driver-app && npm run release:prep",
    "backup:storage": "node ./scripts/backup-supabase-storage.mjs",
    "verify:storage-backup": "node ./scripts/verify-supabase-storage-backup.mjs",
    "sanitize:schema-backup": "node ./scripts/sanitize-supabase-schema-backup.mjs"
  }
}
