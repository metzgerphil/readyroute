SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTE_OPTIMIZATION_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SYNC_CREDENTIALS_KEY=
FEDEX_SYNC_WORKER_SECRET=
READYROUTE_INTERNAL_WORKER_SECRET=
# Keep FCC/MyBizAccount browser automation off unless FedEx-approved access is in place.
FEDEX_FCC_AUTOMATION_ENABLED=false
FEDEX_SYNC_MODE=both
FEDEX_SYNC_MANIFEST_INTERVAL_MS=300000
FEDEX_SYNC_PROGRESS_INTERVAL_MS=90000
FEDEX_SYNC_TICK_INTERVAL_MS=15000
FEDEX_INGEST_SHARED_SECRET=
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2026-06-24.dahlia
STRIPE_PUBLISHABLE_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
RRA_COMPANY_PORTAL_URL=https://readyroute.org/portal
STAFF_PORTAL_URL=https://staff.readyroute.org
RRA_IOS_APP_URL=https://apps.apple.com/us/app/ready-route/id6762488881
# Add the public Play Store URL after the Android listing is published.
RRA_ANDROID_APP_URL=
STRIPE_PORTAL_RETURN_URL=https://readyroute.org/portal?view=billing
# Enable only with test credentials first. Live charging still requires the
# separate READYROUTE_LIVE_BILLING_APPROVED launch gate.
STRIPE_SIGNUP_ENABLED=false
# Independent kill switch for creating the first live company subscription.
# Leave false until Stripe products, webhook handling, taxes, and an acceptance
# test have been reviewed and the product owner explicitly approves charging.
READYROUTE_LIVE_BILLING_APPROVED=false
# Do not enable Tax until ReadyRoute's registrations and product tax code have
# been confirmed with its tax professional and recorded in Stripe.
STRIPE_TAX_ENABLED=false
STRIPE_TAX_REGISTRATIONS_CONFIRMED=false
BILLING_CONSENT_HASH_SALT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
READYROUTE_SUPPORT_NOTIFY_EMAIL=
READYROUTE_PUSH_NOTIFICATIONS=false
# Quality-first answering requires active AI interpretation. Free-form questions
# fail closed in off or shadow mode; exact approved patterns remain available.
READYROUTE_DRIVER_HELP_AI_INTERPRETATION_MODE=active
# Legacy active-mode switch. Prefer the explicit mode above.
READYROUTE_DRIVER_HELP_AI_INTERPRETATION_ENABLED=false
# AI is used only to select an approved record and branch. Canonical record
# content is rendered directly; no second model call composes answer prose.
READYROUTE_DRIVER_HELP_AI_ENABLED=false
READYROUTE_DRIVER_HELP_MODEL=gpt-5.6-luna
READYROUTE_DRIVER_HELP_AI_REASONING_EFFORT=medium
READYROUTE_DRIVER_HELP_AI_TIMEOUT_MS=20000
OPENAI_API_KEY=
# Optional OpenAI-compatible API base; defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=
STORAGE_SIGNED_URL_TTL_SECONDS=900
RATE_LIMIT_GLOBAL=3000
RATE_LIMIT_LOGIN=20
RATE_LIMIT_PASSWORD_RESET=6
RATE_LIMIT_PUBLIC_FORM=20
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_DRIVER_POSITION=30

# Production smoke checks. These are used by GitHub Actions and local release
# checks; keep the real values in GitHub/Google Cloud secrets, not in this file.
SMOKE_BACKEND_URL=https://api.readyroute.org
SMOKE_PORTAL_URL=https://portal.readyroute.org
SMOKE_MANAGER_EMAIL=
SMOKE_MANAGER_PASSWORD=
PORT=3001
