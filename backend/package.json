{
  "name": "readyroute-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src --ext js,json src/index.js",
    "playwright:install": "playwright install --with-deps chromium",
    "fedex:sync": "node src/scripts/runFedexSync.js",
    "fedex:sync:manifests": "FEDEX_SYNC_MODE=manifests node src/scripts/runFedexSync.js",
    "fedex:sync:progress": "FEDEX_SYNC_MODE=progress node src/scripts/runFedexSync.js",
    "fedex:sync:daemon": "node src/scripts/runFedexSyncDaemon.js",
    "knowledge:import": "node src/scripts/importDriverKnowledge.js",
    "knowledge:import:dry-run": "node src/scripts/importDriverKnowledge.js --dry-run",
    "knowledge:validate-retrieval": "node src/scripts/validateDriverHelpRetrieval.js",
    "knowledge:validate-candidate-retrieval": "node src/scripts/validateCandidateOperationalRetrieval.js",
    "knowledge:validate-driver-bot-contract": "node src/scripts/validateDriverBotInteractionContract.js",
    "knowledge:validate-traceability": "node src/scripts/validatePhase3Traceability.js",
    "gate-codes:parse": "node src/scripts/parseGateCodesDocx.js",
    "gate-codes:review": "node src/scripts/reviewGateCodeImport.js",
    "seed:auth": "node src/scripts/seedAuthUsers.js",
    "seed:manager": "node src/scripts/addManagerUser.js",
    "smoke:production": "node src/scripts/productionSmoke.js",
    "smoke:provision-manager": "node src/scripts/provisionProductionSmokeManager.js",
    "check:launch": "node src/scripts/checkLaunchConfig.js",
    "verify:schema": "node ../scripts/check-schema-version.js",
    "test:unit": "node --test src/**/*.test.js",
    "test:phase2-db": "READYROUTE_PHASE2_DB_INTEGRATION=true node --test src/routes/phase2DatabaseAuth.integration.test.js",
    "test:e2e": "jest --runInBand tests/e2e.test.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "axios": "^1.8.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "playwright": "^1.59.1",
    "stripe": "^22.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
