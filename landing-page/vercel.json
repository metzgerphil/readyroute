{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mvp",
      "destination": "/signup",
      "permanent": false
    },
    {
      "source": "/staff",
      "destination": "https://portal.readyroute.org/readyroute/support",
      "permanent": false
    },
    {
      "source": "/staff/:path*",
      "destination": "https://portal.readyroute.org/readyroute/:path*",
      "permanent": false
    }
  ]
}
